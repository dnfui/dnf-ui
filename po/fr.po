msgid "dnf5daemon transaction session is not available."
msgstr "La session de transaction dnf5daemon n'est pas disponible."

msgid "Transaction preview was cancelled."
msgstr "L'aperçu de la transaction a été annulé."

msgid "dnf5daemon failed to resolve the transaction."
msgstr "dnf5daemon n'a pas pu résoudre la transaction."

msgid "dnf5daemon could not resolve the transaction."
msgstr "dnf5daemon n'a pas pu résoudre la transaction."

msgid "Repository data is unavailable. Connect to the network, refresh repositories, and try again."
msgstr "Les données des dépôts ne sont pas disponibles. Connectez-vous au réseau, actualisez les dépôts et réessayez."

msgid "dnf5daemon returned an unsupported transaction resolve result."
msgstr "dnf5daemon a renvoyé un résultat de résolution de transaction non pris en charge."

msgid "Transaction apply was cancelled."
msgstr "L'application de la transaction a été annulée."

msgid "Failed to close the dnf5daemon session."
msgstr "Impossible de fermer la session dnf5daemon."

