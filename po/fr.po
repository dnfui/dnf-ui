msgstr "Impossible de marquer la mise à jour globale dans dnf5daemon."

msgid "Could not list upgrade targets from dnf5daemon."
msgstr "Impossible de lister les paquets pouvant être mis à jour depuis dnf5daemon."

msgid "dnf5daemon returned a repository without an ID."
msgstr "dnf5daemon a renvoyé un dépôt sans identifiant."

msgid "dnf5daemon returned a repository without a valid enabled state."
msgstr "dnf5daemon a renvoyé un dépôt sans état d'activation valide."

msgid "dnf5daemon returned an invalid repository list."
msgstr "dnf5daemon a renvoyé une liste de dépôts invalide."

msgid "dnf5daemon returned duplicate repository IDs."
msgstr "dnf5daemon a renvoyé des identifiants de dépôts en double."

msgid "dnf5daemon repository change failed."
