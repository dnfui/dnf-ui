msgstr "Förrådsuppdateringen avbröts."

msgid "dnf5daemon repository refresh failed."
msgstr "dnf5daemon-förrådsuppdatering misslyckades."

msgid "Could not mark packages in dnf5daemon."
msgstr "Kunde inte markera paket i dnf5daemon."

msgid ""
"dnf5daemon is not available. Make sure dnf5daemon-server is installed and "
