msgstr "O dnf5daemon retornou uma lista de repositórios inválida."

msgid "dnf5daemon returned duplicate repository IDs."
msgstr "O dnf5daemon retornou identificadores de repositórios duplicados."

msgid "dnf5daemon repository change failed."
msgstr "Falha ao alterar o repositório pelo dnf5daemon."

msgid "Could not list repositories from dnf5daemon."
msgstr "Não foi possível listar os repositórios pelo dnf5daemon."

msgid "dnf5daemon transaction session is not available."
msgstr "A sessão de transação do dnf5daemon não está disponível."

msgid "Transaction preview was cancelled."
msgstr "A prévia da transação foi cancelada."

msgid "dnf5daemon failed to resolve the transaction."
msgstr "O dnf5daemon falhou ao resolver a transação."

msgid "dnf5daemon could not resolve the transaction."
msgstr "O dnf5daemon não conseguiu resolver a transação."

msgid "Repository data is unavailable. Connect to the network, refresh repositories, and try again."
msgstr "Os dados dos repositórios não estão disponíveis. Conecte-se à rede, atualize os repositórios e tente novamente."

msgid "dnf5daemon returned an unsupported transaction resolve result."
msgstr "O dnf5daemon retornou um resultado de resolução de transação não compatível."

msgid "Transaction apply was cancelled."
msgstr "A aplicação da transação foi cancelada."

msgid "Failed to close the dnf5daemon session."
msgstr "Falha ao encerrar a sessão do dnf5daemon."

